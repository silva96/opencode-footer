{
  "name": "opencode-footer",
  "version": "1.0.0",
  "description": "A wrapping OpenCode V2 footer with model, session, and optional Codex quota information",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silva96/opencode-footer.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "tui.ts",
    "src/tui.tsx",
    "src/configurator.tsx",
    "src/options.mjs",
    "src/settings.mjs",
    "src/statusline-config.mjs",
    "src/status-parts.mjs",
    "src/model-switch.mjs",
    "src/codex-quota.mjs",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test src/*.test.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
