{
  "name": "opencode-footer",
  "version": "1.0.4",
  "description": "A wrapping OpenCode V2 footer with model, session, and optional Codex quota information",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silva96/opencode-footer.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
